rules_version = '2';

// Правила для Ghostlink. Модель данных:
//   users/{uid}                    name, online, lastSeen
//   chats/{a_b}                    members [a, b] (отсортированы), lastMessage, updatedAt, lastRead.{uid}
//   chats/{a_b}/messages/{id}      senderId, text, sentAt
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 40;
    }

    // Профили видны любому вошедшему: иначе нельзя показать имя по отсканированному коду.
    // Менять можно только свой.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validName(request.resource.data.name)
        && request.resource.data.keys().hasOnly(['name', 'online', 'lastSeen']);
    }

    match /chats/{chatId} {
      // resource == null — проверка «есть ли уже чат» перед созданием.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);

      // Чат пары создаёт один из её участников; id однозначно задаётся парой.
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];

      // Участники обновляют lastMessage / updatedAt / свой lastRead, но не состав чата.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'updatedAt', 'lastRead'])
        && request.resource.data.lastRead.diff(resource.data.get('lastRead', {})).affectedKeys()
             .hasOnly([request.auth.uid]);

      match /messages/{messageId} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        allow read: if signedIn() && isMember();

        // Писать можно только от своего имени и только с серверным временем.
        allow create: if signedIn()
          && isMember()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.sentAt == request.time;

        // Сообщения неизменяемы.
        allow update, delete: if false;
      }
    }
  }
}
