rules_version = '2';

// Правила для Ghostlink. Модель данных:
//   users/{uid}                    name, online, lastSeen
//   users/{uid}/devices/{id}       name, platform, lastActiveAt — реестр устройств аккаунта
//   users/{uid}/chatPrefs/{a_b}    pinnedAt?, muted?, clearedAt?, hidden? — личные настройки чата
//   linkRequests/{id}              owner, deviceName, platform, createdAt, expiresAt, payload, approvedBy
//   chats/{a_b}                    members [a, b] (отсортированы), lastMessage, updatedAt, lastRead.{uid}
//   chats/{a_b}/messages/{id}      senderId, text, sentAt, replyTo? {id, senderId, preview}, editedAt?, deletedAt?
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 40;
    }

    function shortString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // Временный аккаунт нового устройства анонимный; настоящие аккаунты входят по ключу (email/password).
    function hasAccountKey() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Профили видны любому вошедшему: иначе нельзя показать имя по отсканированному коду.
    // Менять можно только свой.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validName(request.resource.data.name)
        && request.resource.data.keys().hasOnly(['name', 'online', 'lastSeen']);

      // Реестр устройств видит и меняет только сам аккаунт.
      match /devices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'platform', 'lastActiveAt'])
          && shortString(request.resource.data.name, 60)
          && shortString(request.resource.data.platform, 20)
          && request.resource.data.lastActiveAt == request.time;
      }
    }

    // Личные настройки чатов (закреплён, без звука, удалён из списка) видит и меняет только владелец:
    // собеседник не узнаёт, что его заглушили или удалили.
    match /users/{uid}/chatPrefs/{chatId} {
      function prefsData() {
        return request.resource.data;
      }

      // Отметки времени ставит сервер; уже стоящую можно оставить как есть.
      function serverTimeOrSame(field) {
        return !(field in prefsData())
          || prefsData()[field] == request.time
          || (resource != null && field in resource.data && prefsData()[field] == resource.data[field]);
      }

      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && prefsData().keys().hasOnly(['pinnedAt', 'muted', 'clearedAt', 'hidden'])
        && (!('muted' in prefsData()) || prefsData().muted is bool)
        && (!('hidden' in prefsData()) || prefsData().hidden is bool)
        && serverTimeOrSame('pinnedAt')
        && serverTimeOrSame('clearedAt');
    }

    // Заявка на вход с нового устройства. Новое устройство создаёт её под временным анонимным
    // аккаунтом, устройство с аккаунтом кладёт в неё ключ, зашифрованный публичным ключом из QR.
    match /linkRequests/{requestId} {
      // id случайный и известен только из QR, а payload без закрытого ключа бесполезен.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'deviceName', 'platform', 'createdAt', 'expiresAt'])
        && request.resource.data.owner == request.auth.uid
        && shortString(request.resource.data.deviceName, 60)
        && shortString(request.resource.data.platform, 20)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'm');

      // Подтвердить можно один раз, пока заявка жива, и только с настоящего аккаунта.
      allow update: if signedIn()
        && hasAccountKey()
        && request.auth.uid != resource.data.owner
        && !('payload' in resource.data)
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload', 'approvedBy'])
        && request.resource.data.payload is bytes
        && request.resource.data.payload.size() <= 512
        && request.resource.data.approvedBy == request.auth.uid;

      allow delete: if signedIn() && request.auth.uid == resource.data.owner;
    }

    match /chats/{chatId} {
      // resource == null — проверка «есть ли уже чат» перед созданием.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);

      // Чат пары создаёт один из её участников; id однозначно задаётся парой.
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];

      // «Печатает…»: только своя отметка и только серверным временем (или снятие отметки).
      function validTyping() {
        let after = request.resource.data.get('typing', {});
        return after.diff(resource.data.get('typing', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in after) || after[request.auth.uid] == request.time);
      }

      // Участники обновляют lastMessage / updatedAt / свой lastRead / свой typing, но не состав чата.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'updatedAt', 'lastRead', 'typing'])
        && request.resource.data.get('lastRead', {}).diff(resource.data.get('lastRead', {})).affectedKeys()
             .hasOnly([request.auth.uid])
        && validTyping();

      match /messages/{messageId} {
        function members() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        function isMember() {
          return request.auth.uid in members();
        }

        function validText(text) {
          return text is string && text.size() > 0 && text.size() <= 4000;
        }

        // Ответ ссылается на сообщение участника этого же чата; превью — первые 100 символов исходного текста.
        function validReplyTo(data) {
          return !('replyTo' in data)
            || (data.replyTo is map
              && data.replyTo.keys().hasAll(['id', 'senderId', 'preview'])
              && data.replyTo.keys().hasOnly(['id', 'senderId', 'preview'])
              && shortString(data.replyTo.id, 64)
              && data.replyTo.senderId in members()
              && shortString(data.replyTo.preview, 100));
        }

        allow read: if signedIn() && isMember();

        // Писать можно только от своего имени и только с серверным временем.
        allow create: if signedIn()
          && isMember()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt', 'replyTo'])
          && request.resource.data.senderId == request.auth.uid
          && validText(request.resource.data.text)
          && request.resource.data.sentAt == request.time
          && validReplyTo(request.resource.data);

        // Своё сообщение можно исправить: меняется только текст, editedAt — серверное время правки.
        function isEdit() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && validText(request.resource.data.text)
            && request.resource.data.editedAt == request.time;
        }

        // Удаление у обоих участников: от сообщения остаются автор, время и отметка deletedAt,
        // чтобы в чате было видно «Сообщение удалено».
        function isSoftDelete() {
          return request.resource.data.keys().hasOnly(['senderId', 'sentAt', 'deletedAt'])
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.sentAt == resource.data.sentAt
            && request.resource.data.deletedAt == request.time;
        }

        // Удалённое сообщение больше не меняется.
        allow update: if signedIn()
          && isMember()
          && resource.data.senderId == request.auth.uid
          && !('deletedAt' in resource.data)
          && (isEdit() || isSoftDelete());

        // Полное удаление — для клиентов до появления отметки «Сообщение удалено».
        allow delete: if signedIn()
          && isMember()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
